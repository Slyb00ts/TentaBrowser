+//! Behavioral tests for the minimal TentaBrowser native property extensions.
+
+use super::{
+    ClassKind, DefinePropertyDescriptor, JsCell, JsClass, PropertyDescriptor, PropertyName, Trace,
+    Tracer, Writable,
