+// Unlike the public API's asynchronous StackGuard request, this is called
+// from an active same-thread slow API callback after a sticky host budget
+// failure. It must not be called from a Fast API, GC, or heap-limit hook.
+// V8's API callback return path observes the exception field immediately.
+// A sticky budget failure dominates even a pending ordinary page exception.
+// Follow public ThrowException's clear-internal-then-Throw sequence; Throw
+// propagates the termination sentinel to the external TryCatch. If termination
+// is already active, there is nothing more to do.
+void v8__Isolate__TerminateExecutionNowFromCallback(v8::Isolate* isolate) {
+  auto* internal = reinterpret_cast<v8::internal::Isolate*>(isolate);
+  if (internal->has_exception() && internal->is_execution_terminating()) return;
+  v8::EnterV8BasicScope api_scope(internal);
+  if (internal->has_exception()) {
+    internal->clear_internal_exception();
+  }
+  internal->TerminateExecution();
+}
+
 bool v8__Isolate__IsExecutionTerminating(v8::Isolate* isolate) {
   return isolate->IsExecutionTerminating();
 }
