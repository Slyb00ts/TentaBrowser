+//! Same-artifact, separate-call-site Symbol store/read/delete controls.
+//! No forced optimization, tracing, counters or descriptor checks in timing.
+
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::time::Instant;
+
+fn decline_query<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    _name: v8::Local<'s, v8::Name>,
+    _args: v8::PropertyCallbackArguments<'s>,
+    _rv: v8::ReturnValue<v8::Integer>,
+) -> v8::Intercepted {
+    match catch_unwind(AssertUnwindSafe(|| v8::Intercepted::kNo)) {
+        Ok(result) => result,
+        Err(payload) => {
+            std::mem::forget(payload);
+            scope.terminate_execution();
+            v8::Intercepted::kYes
+        }
+    }
+}
+
+fn empty_names<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    _args: v8::PropertyCallbackArguments<'s>,
+    mut rv: v8::ReturnValue<v8::Array>,
+) {
+    if let Err(payload) = catch_unwind(AssertUnwindSafe(|| {
+        rv.set(v8::Array::new(scope, 0));
+    })) {
+        std::mem::forget(payload);
+        scope.terminate_execution();
+    }
+}
+
+const CONTROL: &str = r#"
+(() => {
+    const object = globalThis.CASE_LABEL;
+    const persistent = Symbol('persistent');
+    const transient = Symbol('transient');
+    object[persistent] = 73;
+    function CASE_LABELCycle(count) {
+        let checksum = 0;
+        for (let i = 0; i < count; ++i) {
+            object[transient] = i;
+            checksum += object[transient];
+            delete object[transient];
+        }
+        return checksum;
+    }
+    function CASE_LABELCheck() {
+        const d = Object.getOwnPropertyDescriptor(object, persistent);
+        if (!d || d.value !== 73 || !d.writable || !d.enumerable || !d.configurable || Object.hasOwn(object, transient)) throw Error('persistent descriptor');
+        object[transient] = 91;
+        const t = Object.getOwnPropertyDescriptor(object, transient);
+        if (!t || t.value !== 91 || !t.writable || !t.enumerable || !t.configurable) throw Error('transient descriptor');
+        const keys = Object.getOwnPropertySymbols(object);
+        if (keys.length !== 2 || keys[0] !== persistent || keys[1] !== transient) throw Error('symbol order');
+        // Preserve the workload's shape: deleting a non-last persistent key
+        // could permanently convert this receiver to dictionary properties.
+        // Non-last deletion/reinsertion is covered by the native test suite.
+        if (!delete object[transient] || Object.hasOwn(object, transient)) throw Error('delete transient');
+        return true;
+    }
+    return [CASE_LABELCycle, CASE_LABELCheck];
+})()
+"#;
+
+struct Case {
+    name: &'static str,
+    run: v8::Global<v8::Function>,
+    check: v8::Global<v8::Function>,
+}
+
+fn create_case(scope: &mut v8::PinScope<'_, '_>, name: &'static str) -> Case {
+    let object = if name == "plain" {
+        v8::Object::new(scope)
+    } else {
+        let template = v8::ObjectTemplate::new(scope);
+        let flags = v8::PropertyHandlerFlags::ONLY_INTERCEPT_STRINGS
+            | if name == "marked" {
+                v8::PropertyHandlerFlags::WEB_IDL_LEGACY
+            } else {
+                v8::PropertyHandlerFlags::NONE
+            };
+        template.set_named_property_handler(
+            v8::NamedPropertyHandlerConfiguration::new()
+                .query(decline_query)
+                .enumerator(empty_names)
+                .flags(flags),
+        );
+        template.new_instance(scope).expect("API receiver")
+    };
+    let global = scope.get_current_context().global(scope);
+    let key = v8::String::new(scope, name).expect("case name");
+    assert_eq!(global.set(scope, key.into(), object.into()), Some(true));
+    let source = v8::String::new(scope, &CONTROL.replace("CASE_LABEL", name)).expect("case source");
+    let script = v8::Script::compile(scope, source, None).expect("compile case");
+    let value = script.run(scope).expect("initialize case");
+    let functions = v8::Local::<v8::Array>::try_from(value).expect("case functions");
+    let run = functions.get_index(scope, 0).expect("run");
+    let check = functions.get_index(scope, 1).expect("check");
+    Case {
+        name,
+        run: v8::Global::new(
+            scope,
+            v8::Local::<v8::Function>::try_from(run).expect("run function"),
+        ),
+        check: v8::Global::new(
+            scope,
+            v8::Local::<v8::Function>::try_from(check).expect("check function"),
+        ),
+    }
+}
+
+fn check(scope: &mut v8::PinScope<'_, '_>, case: &Case) {
+    let function = v8::Local::new(scope, &case.check);
+    let receiver = v8::undefined(scope);
+    let result = function
+        .call(scope, receiver.into(), &[])
+        .expect("descriptor/order check");
+    assert!(result.is_true(), "{} control failed", case.name);
+}
+
+fn batch(scope: &mut v8::PinScope<'_, '_>, case: &Case, count: u32) -> (u128, u64) {
+    let function = v8::Local::new(scope, &case.run);
+    let receiver = v8::undefined(scope);
+    let count_value = v8::Integer::new_from_unsigned(scope, count);
+    let start = Instant::now();
+    let value = function
+        .call(scope, receiver.into(), &[count_value.into()])
+        .expect("timed cycle");
+    let elapsed = start.elapsed().as_nanos();
+    let checksum = value.number_value(scope).expect("numeric checksum");
+    let expected = u64::from(count) * u64::from(count - 1) / 2;
+    assert_eq!(checksum, expected as f64, "{} checksum", case.name);
+    (elapsed, expected)
+}
+
+fn main() {
+    let arguments: Vec<_> = std::env::args().skip(1).collect();
+    assert!(
+        arguments.len() <= 1,
+        "usage: symbol_store_control [1000|10000|100000]"
+    );
+    let warmup: u32 = arguments
+        .first()
+        .map_or(100_000, |s| s.parse().expect("warmup integer"));
+    assert!(
+        [1_000, 10_000, 100_000].contains(&warmup),
+        "unsupported warmup"
+    );
+    v8::V8::initialize_platform(v8::new_default_platform(0, false).make_shared());
+    v8::V8::initialize();
+    let isolate = &mut v8::Isolate::new(Default::default());
+    v8::scope!(let scope, isolate);
+    let context = v8::Context::new(scope, Default::default());
+    let mut entered = v8::ContextScope::new(scope, context);
+    v8::scope!(let scope, &mut entered);
+    let cases = [
+        create_case(scope, "marked"),
+        create_case(scope, "unmarked"),
+        create_case(scope, "plain"),
+    ];
+    for case in &cases {
+        check(scope, case);
+        for _ in 0..2 {
+            batch(scope, case, warmup);
+            check(scope, case);
+        }
+    }
+    for batch_index in 0..10 {
+        for position in 0..cases.len() {
+            let case = &cases[(batch_index + position) % cases.len()];
+            let (elapsed, checksum) = batch(scope, case, 100_000);
+            check(scope, case);
+            println!(
+                "{{\"case\":\"{}\",\"warmup\":{},\"warmup_batches\":2,\"batch\":{},\"position\":{},\"iterations\":100000,\"elapsed_ns\":{},\"ns_per_lifecycle\":{},\"checksum\":{}}}",
+                case.name,
+                warmup,
+                batch_index,
+                position,
+                elapsed,
+                elapsed as f64 / 100_000.0,
+                checksum
+            );
+        }
+    }
+}
