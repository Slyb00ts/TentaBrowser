+  // normalized-storage helper. The inner commit already establishes its order.
+  if (OrderedHashSet::HasKey(isolate, *prepared, *name)) return;
+  CHECK_LT(prepared->UsedCapacity(), prepared->Capacity());
+  DirectHandle<OrderedHashSet> result =
