+    AtomicSlot end(start + count);
+    std::sort(start, end, [](Tagged_t a, Tagged_t b) {
+#ifdef V8_COMPRESS_POINTERS
+      Tagged<Object> left(V8HeapCompressionScheme::DecompressTagged(a));
+      Tagged<Object> right(V8HeapCompressionScheme::DecompressTagged(b));
+#else
+      Tagged<Object> left(a);
+      Tagged<Object> right(b);
+#endif
