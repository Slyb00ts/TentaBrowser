+// Match the ordinary, non-host object cases of the pinned V8 serializer.
+// API wrappers and every specialized builtin require a separate host decision.
+// This is a native tag read, with no allocation or page-owned property access.
+bool v8__Value__IsStructuredCloneOrdinaryObject(const v8::Value& self) {
+  if (!self.IsObject() || self.IsFunction()) return false;
+  namespace i = v8::internal;
+  const i::Address value = i::ValueHelper::ValueAsAddress(&self);
+  switch (i::Internals::GetInstanceType(value)) {
+    case i::JS_ARRAY_ITERATOR_PROTOTYPE_TYPE:
+    case i::JS_ITERATOR_PROTOTYPE_TYPE:
+    case i::JS_MAP_ITERATOR_PROTOTYPE_TYPE:
+    case i::JS_OBJECT_PROTOTYPE_TYPE:
+    case i::JS_OBJECT_TYPE:
+    case i::JS_PROMISE_PROTOTYPE_TYPE:
+    case i::JS_REG_EXP_PROTOTYPE_TYPE:
+    case i::JS_SET_ITERATOR_PROTOTYPE_TYPE:
+    case i::JS_SET_PROTOTYPE_TYPE:
+    case i::JS_STRING_ITERATOR_PROTOTYPE_TYPE:
+    case i::JS_TYPED_ARRAY_PROTOTYPE_TYPE:
+      return true;
+    default:
+      return false;
+  }
+}
