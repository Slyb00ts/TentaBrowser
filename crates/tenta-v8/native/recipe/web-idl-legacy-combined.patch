+Maybe<bool> KeyAccumulator::CollectWebIdlInterceptorKeys(
+    DirectHandle<JSObject> object, IndexedOrNamed type) {
+  if (type == kIndexed ? !object->HasIndexedInterceptor()
+                       : !object->HasNamedInterceptor()) return Just(true);
