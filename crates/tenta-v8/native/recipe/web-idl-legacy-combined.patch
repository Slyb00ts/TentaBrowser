+static ENUMERATOR_CALLS: AtomicUsize = AtomicUsize::new(0);
+
+fn names_with_gc<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    args: v8::PropertyCallbackArguments<'s>,
+    mut rv: v8::ReturnValue<v8::Array>,
+) {
+    boundary!(scope, (), {
+        ENUMERATOR_CALLS.fetch_add(1, Ordering::SeqCst);
+        scope.low_memory_notification();
+        let names = v8::Local::<v8::Array>::try_from(args.data()).expect("native names");
+        rv.set(names);
+    });
+}
+
+fn throwing_names<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    _args: v8::PropertyCallbackArguments<'s>,
+    _rv: v8::ReturnValue<v8::Array>,
+) {
+    boundary!(scope, (), {
+        ENUMERATOR_CALLS.fetch_add(1, Ordering::SeqCst);
+        let message = v8::String::new(scope, "native enumerator failure").expect("message");
+        let error = v8::Exception::range_error(scope, message);
+        scope.throw_exception(error);
+    });
+}
