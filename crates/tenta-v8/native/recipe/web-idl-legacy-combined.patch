+  if (IsTheHole(existing)) {
+    ASSIGN_RETURN_ON_EXCEPTION_VALUE(
+        isolate, order,
+        OrderedHashSet::Allocate(isolate, OrderedHashSet::kInitialCapacity),
+        Nothing<bool>());
+  } else {
+    order = direct_handle(Cast<OrderedHashSet>(existing), isolate);
+    if (OrderedHashSet::HasKey(isolate, *order, *name)) return Just(true);
