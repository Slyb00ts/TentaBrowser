diff --git a/tests/ordinary_object_brand.rs b/tests/ordinary_object_brand.rs
--- /dev/null
+++ b/tests/ordinary_object_brand.rs
@@ -0,0 +1,195 @@
+//! The native ordinary-record classifier must not execute page-owned behavior.
+
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::Once;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+fn initialize() {
+  static INIT: Once = Once::new();
+  INIT.call_once(|| {
+    v8::V8::initialize_platform(
+      v8::new_default_platform(0, false).make_shared(),
+    );
+    v8::V8::initialize();
+  });
+}
+
+fn evaluate<'s>(
+  scope: &mut v8::PinScope<'s, '_>,
+  source: &str,
+) -> v8::Local<'s, v8::Value> {
+  let text = v8::String::new(scope, source).unwrap();
+  v8::Script::compile(scope, text, None)
+    .unwrap()
+    .run(scope)
+    .unwrap()
+}
+
+#[test]
+fn script_records_and_ordinary_intrinsic_prototypes_are_accepted() {
+  initialize();
+  let isolate = &mut v8::Isolate::new(Default::default());
+  v8::scope!(let scope, isolate);
+  let context = v8::Context::new(scope, Default::default());
+  let scope = &mut v8::ContextScope::new(scope, context);
+  for source in [
+    "({})",
+    "Object.create(null)",
+    "new (class UserClass {})()",
+    "Object.create(Date.prototype)",
+    "Object.create(Intl.DateTimeFormat.prototype)",
+    "Object.freeze({answer: 42})",
+    "(() => { const o={}; for(let i=0;i<100;i++)o['p'+i]=i; delete o.p1; return o })()",
+    "Object.prototype",
+    "Promise.prototype",
+    "RegExp.prototype",
+    "Set.prototype",
+    "Object.getPrototypeOf([][Symbol.iterator]())",
+    "Object.getPrototypeOf(Object.getPrototypeOf([][Symbol.iterator]()))",
+    "Object.getPrototypeOf(new Map()[Symbol.iterator]())",
+    "Object.getPrototypeOf(new Set()[Symbol.iterator]())",
+    "Object.getPrototypeOf(''[Symbol.iterator]())",
+    "Object.getPrototypeOf(Uint8Array.prototype)",
+  ] {
+    let value = evaluate(scope, source);
+    assert!(value.is_structured_clone_ordinary_object(), "{source}");
+  }
+}
+
+#[test]
+fn specialized_values_and_proxy_traps_do_not_enter_the_ordinary_branch() {
+  initialize();
+  let isolate = &mut v8::Isolate::new(Default::default());
+  v8::scope!(let scope, isolate);
+  let context = v8::Context::new(scope, Default::default());
+  let scope = &mut v8::ContextScope::new(scope, context);
+  evaluate(scope, "globalThis.traps=0");
+  for source in [
+    "undefined",
+    "null",
+    "42",
+    "true",
+    "'text'",
+    "1n",
+    "Symbol('x')",
+    "[]",
+    "(function f(){})",
+    "(class C{})",
+    "new Date()",
+    "Object.setPrototypeOf(new Date(), Object.prototype)",
+    "Object.setPrototypeOf(new Date(), null)",
+    "/x/g",
+    "new Map()",
+    "new Set()",
+    "new WeakMap()",
+    "new WeakSet()",
+    "new Error('x')",
+    "Promise.resolve(1)",
+    "new ArrayBuffer(8)",
+    "new SharedArrayBuffer(8)",
+    "new DataView(new ArrayBuffer(8))",
+    "new Uint8Array(8)",
+    "new Number(1)",
+    "new Boolean(true)",
+    "new String('x')",
+    "Object(Symbol('x'))",
+    "Object(1n)",
+    "new WeakRef({})",
+    "[][Symbol.iterator]()",
+    "new Map()[Symbol.iterator]()",
+    "globalThis",
+    "new Intl.DateTimeFormat('en')",
+    "Object.setPrototypeOf(new Intl.DateTimeFormat('en'), Object.prototype)",
+    "Object.setPrototypeOf(new Intl.DateTimeFormat('en'), null)",
+    "Temporal.PlainDate.from('2026-09-24')",
+    "new Proxy({}, {get(){traps++;throw 1},getPrototypeOf(){traps++;throw 2},ownKeys(){traps++;throw 3}})",
+    "(() => {const p=Proxy.revocable({},{});p.revoke();return p.proxy})()",
+  ] {
+    let value = evaluate(scope, source);
+    assert!(!value.is_structured_clone_ordinary_object(), "{source}");
+  }
+  let plain = evaluate(
+    scope,
+    "Object.defineProperties({}, {constructor:{get(){traps++;throw 4}},[Symbol.toStringTag]:{get(){traps++;throw 5}}})",
+  );
+  assert!(plain.is_structured_clone_ordinary_object());
+  assert_eq!(evaluate(scope, "traps").integer_value(scope), Some(0));
+}
+
+static INTERCEPTOR_CALLS: AtomicUsize = AtomicUsize::new(0);
+static FUNCTION_CALLS: AtomicUsize = AtomicUsize::new(0);
+
+fn callable_object(
+  scope: &mut v8::PinScope,
+  _args: v8::FunctionCallbackArguments,
+  _return_value: v8::ReturnValue<v8::Value>,
+) {
+  if let Err(payload) = catch_unwind(AssertUnwindSafe(|| {
+    FUNCTION_CALLS.fetch_add(1, Ordering::Relaxed);
+  })) {
+    std::mem::forget(payload);
+    scope.terminate_execution();
+  }
+}
+
+fn named_getter<'s>(
+  scope: &mut v8::PinScope<'s, '_>,
+  _name: v8::Local<'s, v8::Name>,
+  _args: v8::PropertyCallbackArguments<'s>,
+  _return_value: v8::ReturnValue<v8::Value>,
+) -> v8::Intercepted {
+  match catch_unwind(AssertUnwindSafe(|| {
+    INTERCEPTOR_CALLS.fetch_add(1, Ordering::Relaxed);
+    v8::Intercepted::kNo
+  })) {
+    Ok(result) => result,
+    Err(payload) => {
+      std::mem::forget(payload);
+      scope.terminate_execution();
+      v8::Intercepted::kYes
+    }
+  }
+}
+
+#[test]
+fn native_wrappers_and_interceptors_are_rejected_without_a_callback() {
+  initialize();
+  let isolate = &mut v8::Isolate::new(Default::default());
+  v8::scope!(let scope, isolate);
+  let context = v8::Context::new(scope, Default::default());
+  let scope = &mut v8::ContextScope::new(scope, context);
+  let template = v8::ObjectTemplate::new(scope);
+  template.set_internal_field_count(1);
+  let host = template.new_instance(scope).unwrap();
+  assert!(!host.is_structured_clone_ordinary_object());
+  let callable = v8::ObjectTemplate::new(scope);
+  callable.set_call_as_function_handler(callable_object, None);
+  let callable = callable.new_instance(scope).unwrap();
+  assert!(callable.is_callable());
+  assert!(!callable.is_structured_clone_ordinary_object());
+  assert_eq!(FUNCTION_CALLS.load(Ordering::Relaxed), 0);
+  let intercepted = v8::ObjectTemplate::new(scope);
+  intercepted.set_named_property_handler(
+    v8::NamedPropertyHandlerConfiguration::new().getter(named_getter),
+  );
+  let intercepted = intercepted.new_instance(scope).unwrap();
+  assert!(!intercepted.is_structured_clone_ordinary_object());
+  assert_eq!(INTERCEPTOR_CALLS.load(Ordering::Relaxed), 0);
+}
+
+#[test]
+fn cross_realm_objects_remain_classifiable_after_real_gc() {
+  initialize();
+  let isolate = &mut v8::Isolate::new(Default::default());
+  v8::scope!(let scope, isolate);
+  let first = v8::Context::new(scope, Default::default());
+  let value = {
+    let first_scope = &mut v8::ContextScope::new(scope, first);
+    evaluate(first_scope, "new (class FromFirstRealm {})()")
+  };
+  let second = v8::Context::new(scope, Default::default());
+  let second_scope = &mut v8::ContextScope::new(scope, second);
+  assert!(value.is_structured_clone_ordinary_object());
+  second_scope.low_memory_notification();
+  assert!(value.is_structured_clone_ordinary_object());
+}
diff --git a/tests/web_idl_legacy.rs b/tests/web_idl_legacy.rs
--- /dev/null
+++ b/tests/web_idl_legacy.rs
@@ -0,0 +1,174 @@
+//! Controls for the opt-in Web IDL legacy interceptor path.
+//!
+//! This test belongs to the pinned rusty_v8 fork. It must run against a
+//! source-built V8 archive containing the corresponding native patch.
+
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::Once;
+
+fn initialize_v8() {
+    static INIT: Once = Once::new();
+    INIT.call_once(|| {
+        let platform = v8::new_default_platform(0, false).make_shared();
+        v8::V8::initialize_platform(platform);
+        v8::V8::initialize();
+    });
+}
+
+fn decline_indexed_set<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    _index: u32,
+    _value: v8::Local<'s, v8::Value>,
+    _args: v8::PropertyCallbackArguments<'s>,
+    _rv: v8::ReturnValue<v8::Boolean>,
+) -> v8::Intercepted {
+    match catch_unwind(AssertUnwindSafe(|| v8::Intercepted::kNo)) {
+        Ok(result) => result,
+        Err(payload) => {
+            std::mem::forget(payload);
+            scope.terminate_execution();
+            v8::Intercepted::kYes
+        }
+    }
+}
+
+fn reject_indexed_define<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    _index: u32,
+    _descriptor: &v8::PropertyDescriptor,
+    _args: v8::PropertyCallbackArguments<'s>,
+    mut rv: v8::ReturnValue<v8::Boolean>,
+) -> v8::Intercepted {
+    match catch_unwind(AssertUnwindSafe(|| {
+        rv.set_bool(false);
+        v8::Intercepted::kYes
+    })) {
+        Ok(result) => result,
+        Err(payload) => {
+            std::mem::forget(payload);
+            scope.terminate_execution();
+            v8::Intercepted::kYes
+        }
+    }
+}
+
+fn decline_named_set<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    _name: v8::Local<'s, v8::Name>,
+    _value: v8::Local<'s, v8::Value>,
+    _args: v8::PropertyCallbackArguments<'s>,
+    _rv: v8::ReturnValue<v8::Boolean>,
+) -> v8::Intercepted {
+    match catch_unwind(AssertUnwindSafe(|| v8::Intercepted::kNo)) {
+        Ok(result) => result,
+        Err(payload) => {
+            std::mem::forget(payload);
+            scope.terminate_execution();
+            v8::Intercepted::kYes
+        }
+    }
+}
+
+fn reject_named_define<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    _name: v8::Local<'s, v8::Name>,
+    _descriptor: &v8::PropertyDescriptor,
+    _args: v8::PropertyCallbackArguments<'s>,
+    mut rv: v8::ReturnValue<v8::Boolean>,
+) -> v8::Intercepted {
+    match catch_unwind(AssertUnwindSafe(|| {
+        rv.set_bool(false);
+        v8::Intercepted::kYes
+    })) {
+        Ok(result) => result,
+        Err(payload) => {
+            std::mem::forget(payload);
+            scope.terminate_execution();
+            v8::Intercepted::kYes
+        }
+    }
+}
+
+#[test]
+fn only_marked_indexed_handlers_consult_the_definer_during_set() {
+    initialize_v8();
+    let isolate = &mut v8::Isolate::new(Default::default());
+    v8::scope!(let scope, isolate);
+    let context = v8::Context::new(scope, Default::default());
+    let mut context_scope = v8::ContextScope::new(scope, context);
+    v8::scope!(let scope, &mut context_scope);
+
+    for (name, flags) in [
+        ("ordinary", v8::PropertyHandlerFlags::NONE),
+        ("legacy", v8::PropertyHandlerFlags::WEB_IDL_LEGACY),
+    ] {
+        let template = v8::ObjectTemplate::new(scope);
+        template.set_indexed_property_handler(
+            v8::IndexedPropertyHandlerConfiguration::new()
+                .setter(decline_indexed_set)
+                .definer(reject_indexed_define)
+                .flags(flags),
+        );
+        let object = template.new_instance(scope).expect("interceptor instance");
+        let property = v8::String::new(scope, name).expect("global name");
+        assert_eq!(
+            context
+                .global(scope)
+                .set(scope, property.into(), object.into()),
+            Some(true)
+        );
+    }
+
+    for (name, flags) in [
+        (
+            "ordinary_named",
+            v8::PropertyHandlerFlags::ONLY_INTERCEPT_STRINGS,
+        ),
+        (
+            "legacy_named",
+            v8::PropertyHandlerFlags::ONLY_INTERCEPT_STRINGS
+                | v8::PropertyHandlerFlags::WEB_IDL_LEGACY,
+        ),
+    ] {
+        let template = v8::ObjectTemplate::new(scope);
+        template.set_named_property_handler(
+            v8::NamedPropertyHandlerConfiguration::new()
+                .setter(decline_named_set)
+                .definer(reject_named_define)
+                .flags(flags),
+        );
+        let object = template
+            .new_instance(scope)
+            .expect("named interceptor instance");
+        let property = v8::String::new(scope, name).expect("global name");
+        assert_eq!(
+            context
+                .global(scope)
+                .set(scope, property.into(), object.into()),
+            Some(true)
+        );
+    }
+
+    let source = v8::String::new(
+        scope,
+        "const symbol = Symbol('ordinary'); \
+         const derived = {}; \
+         [Reflect.set(ordinary, '2', 8), Object.hasOwn(ordinary, '2'), \
+          Reflect.set(legacy, '2', 8), Object.hasOwn(legacy, '2'), \
+          Reflect.set(legacy, '3', 9, derived), \
+          Object.hasOwn(derived, '3') && !Object.hasOwn(legacy, '3'), \
+          Reflect.set(legacy, symbol, 10), legacy[symbol] === 10, \
+          Reflect.set(ordinary_named, 'plain', 1), Object.hasOwn(ordinary_named, 'plain'), \
+          Reflect.set(legacy_named, 'plain', 1), Object.hasOwn(legacy_named, 'plain'), \
+          Reflect.set(legacy_named, '4294967295', 2), \
+          Object.hasOwn(legacy_named, '4294967295'), \
+          Reflect.set(legacy_named, symbol, 3), legacy_named[symbol] === 3].join('|')",
+    )
+    .expect("script source");
+    let script = v8::Script::compile(scope, source, None).expect("compiled script");
+    let result = script.run(scope).expect("script result");
+    assert_eq!(
+        result.to_rust_string_lossy(scope),
+        "true|true|false|false|true|true|true|true|true|true|false|false|false|false|true|true"
+    );
+}
diff --git a/tests/web_idl_order.rs b/tests/web_idl_order.rs
--- /dev/null
+++ b/tests/web_idl_order.rs
@@ -0,0 +1,840 @@
+//! Native marked-object property order and lifetime controls.
+
+use std::panic::{AssertUnwindSafe, catch_unwind};
+use std::sync::Once;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use v8::MapFnTo;
+
+fn initialize() {
+    static INIT: Once = Once::new();
+    INIT.call_once(|| {
+        v8::V8::initialize_platform(v8::new_default_platform(0, false).make_shared());
+        v8::V8::initialize();
+    });
+}
+
+macro_rules! boundary {
+    ($scope:ident, $fallback:expr, $body:block) => {
+        match catch_unwind(AssertUnwindSafe(|| $body)) {
+            Ok(value) => value,
+            Err(payload) => {
+                // Test callback assertions may panic. Never unwind through V8,
+                // or run a second arbitrary payload destructor on that boundary.
+                std::mem::forget(payload);
+                $scope.terminate_execution();
+                $fallback
+            }
+        }
+    };
+}
+
+fn named_names<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    args: v8::PropertyCallbackArguments<'s>,
+    mut rv: v8::ReturnValue<v8::Array>,
+) {
+    boundary!(scope, (), {
+        let names = v8::Local::<v8::Array>::try_from(args.data()).expect("native name array");
+        rv.set(names);
+    });
+}
+
+fn named_query<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    name: v8::Local<'s, v8::Name>,
+    args: v8::PropertyCallbackArguments<'s>,
+    mut rv: v8::ReturnValue<v8::Integer>,
+) -> v8::Intercepted {
+    boundary!(scope, v8::Intercepted::kYes, {
+        let names = v8::Local::<v8::Array>::try_from(args.data()).expect("native name array");
+        for index in 0..names.length() {
+            let candidate = names.get_index(scope, index).expect("native array entry");
+            if candidate.strict_equals(name.into()) {
+                let hidden = name.to_rust_string_lossy(scope) == "hidden";
+                rv.set(v8::Integer::new(scope, if hidden { 2 } else { 0 }));
+                return v8::Intercepted::kYes;
+            }
+        }
+        v8::Intercepted::kNo
+    })
+}
+
+fn indexed_names<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    _args: v8::PropertyCallbackArguments<'s>,
+    mut rv: v8::ReturnValue<v8::Array>,
+) {
+    boundary!(scope, (), {
+        // Intentionally unsorted: the marked path establishes numeric order.
+        let two = v8::Integer::new_from_unsigned(scope, 2);
+        let zero = v8::Integer::new_from_unsigned(scope, 0);
+        rv.set(v8::Array::new_with_elements(
+            scope,
+            &[two.into(), zero.into()],
+        ));
+    });
+}
+
+fn indexed_query<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    index: u32,
+    _args: v8::PropertyCallbackArguments<'s>,
+    mut rv: v8::ReturnValue<v8::Integer>,
+) -> v8::Intercepted {
+    boundary!(scope, v8::Intercepted::kYes, {
+        if index == 0 || index == 2 {
+            rv.set(v8::Integer::new(scope, 0));
+            v8::Intercepted::kYes
+        } else {
+            v8::Intercepted::kNo
+        }
+    })
+}
+
+fn template<'s>(
+    scope: &mut v8::PinScope<'s, '_>,
+    marked: bool,
+    names: &[&str],
+    indexed: bool,
+) -> v8::Local<'s, v8::ObjectTemplate> {
+    let template = v8::ObjectTemplate::new(scope);
+    let values: Vec<v8::Local<v8::Value>> = names
+        .iter()
+        .map(|name| v8::String::new(scope, name).expect("native name").into())
+        .collect();
+    let data = v8::Array::new_with_elements(scope, &values);
+    let flags = || {
+        if marked {
+            v8::PropertyHandlerFlags::WEB_IDL_LEGACY
+        } else {
+            v8::PropertyHandlerFlags::NONE
+        }
+    };
+    template.set_named_property_handler(
+        v8::NamedPropertyHandlerConfiguration::new()
+            .enumerator(named_names)
+            .query(named_query)
+            .data(data.into())
+            .flags(flags() | v8::PropertyHandlerFlags::ONLY_INTERCEPT_STRINGS),
+    );
+    if indexed {
+        template.set_indexed_property_handler(
+            v8::IndexedPropertyHandlerConfiguration::new()
+                .enumerator(indexed_names)
+                .query(indexed_query)
+                .flags(flags()),
+        );
+    }
+    template
