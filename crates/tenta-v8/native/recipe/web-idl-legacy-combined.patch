+      isolate_->factory()->NewFixedArray(static_cast<int>(capacity));
+  uint32_t count = 0;
+  for (InternalIndex entry : InternalIndex::Range(capacity)) {
+    if (!accessor->HasEntry(isolate_, *result, entry)) continue;
+    DirectHandle<Object> key = accessor->Get(isolate_, result, entry);
+    if (type == kIndexed) {
